{ pkgs, lib, self, ... }:
{
  imports = [
    ./archie.nix
    ../programs/apps/discord.nix
    ../programs/desktop/i3.nix
  ];

  networking.nat.enable = true;
  networking.nat.externalInterface = "enp5s0";

  system.autoUpgrade.flake = lib.mkForce "git+https://github.com/iLikeToCode/nixos-config#ah-w";

  services.xrdp.enable = true;
  services.xrdp.defaultWindowManager = "i3";
  services.openssh.enable = true;

  systemd.targets.sleep.enable = false;
  systemd.targets.suspend.enable = false;
  systemd.targets.hibernate.enable = false;
  systemd.targets.hybrid-sleep.enable = false;

  boot.kernelModules = [ "sg" ];

  services.autorandr = {
    enable = true;
    profiles = {
      desktop3 = {
        fingerprint = {
          DP-1 = "";
          DP-2 = "";
          HDMI-1 = "";
        };

        config = {
          DP-3.enable = false;

          HDMI-1 = {
            enable = true;
            crtc = 0;
            position = "0x0";
            mode = "1920x1080";
            rate = "60.00";
            gamma = "1.0:0.909:0.833";
          };

          DP-1 = {
            enable = true;
            crtc = 2;
            primary = true;
            position = "1920x0";
            mode = "1920x1080";
            rate = "179.82";
            gamma = "1.0:0.909:0.833";
          };

          DP-2 = {
            enable = true;
            crtc = 1;
            position = "3840x0";
            mode = "1920x1080";
            rate = "60.00";
            gamma = "1.0:0.909:0.833";
          };
        };
      };
      desktop2 = {
        fingerprint = {
          DP-1 = "";
          DP-2 = "";
        };

        config = {
          DP-3.enable = false;
          HDMI-1.enable = false;
          
          DP-1 = {
            enable = true;
            crtc = 2;
            primary = true;
            position = "1920x0";
            mode = "1920x1080";
            rate = "179.82";
            gamma = "1.0:0.909:0.833";
          };

          DP-2 = {
            enable = true;
            crtc = 1;
            position = "3840x0";
            mode = "1920x1080";
            rate = "60.00";
            gamma = "1.0:0.909:0.833";
          };
        };
      };
    };
    hooks = {
      postswitch = {
        #"notify-i3" = "DISPLAY=:0 ${pkgs.i3}/bin/i3-msg restart";
      };
    };
  };

  networking.hostName = "AH-W";
}
